{
  "schema_version": 1,
  "draft": true,
  "inputs": [
    {
      "id": "brief",
      "description": "User-supplied goal, constraints and relevant evidence.",
      "required": true
    }
  ],
  "limits": {
    "global_concurrency": 4,
    "per_account_concurrency": 1,
    "max_model_calls": 24,
    "max_retries_per_task": 1,
    "max_wall_seconds": 7200,
    "automatic_account_switching": false
  },
  "execution_mode": "supplied_evidence",
  "name": "Review and revise",
  "goal": "Produce and improve a document, plan or specification against the user's brief.",
  "workers": [
    {
      "id": "author",
      "name": "Author",
      "account_ref": "profile-1",
      "model": "<choose-discovered-model>",
      "role": "writer",
      "instructions": "Write clearly for the intended audience and respect the stated scope.",
      "task": "Create and revise the deliverable."
    },
    {
      "id": "reviewer",
      "name": "Reviewer",
      "account_ref": "profile-2",
      "model": "<choose-discovered-model>",
      "role": "editor",
      "instructions": "Check accuracy, completeness and usability. Separate required fixes from preferences.",
      "task": "Review the deliverable against the brief."
    }
  ],
  "stages": [
    {
      "id": "draft",
      "kind": "independent",
      "workers": [
        "author"
      ],
      "input_stages": [],
      "instruction": "Produce a complete first draft and state assumptions.",
      "context": "fresh",
      "release": "after_all_required",
      "failure_policy": "needs_attention",
      "required_sections": [
        "findings",
        "evidence_or_assumptions",
        "uncertainties",
        "next_action"
      ]
    },
    {
      "id": "review",
      "kind": "critique",
      "workers": [
        "reviewer"
      ],
      "input_stages": [
        "draft"
      ],
      "instruction": "Identify concrete defects and revisions that would improve the draft.",
      "context": "fresh",
      "release": "after_all_required",
      "failure_policy": "needs_attention",
      "required_sections": [
        "findings",
        "evidence_or_assumptions",
        "uncertainties",
        "next_action"
      ]
    },
    {
      "id": "revision",
      "kind": "revise",
      "workers": [
        "author"
      ],
      "input_stages": [
        "draft",
        "review"
      ],
      "instruction": "Revise the draft and respond to each substantive objection.",
      "context": "continue",
      "release": "after_all_required",
      "failure_policy": "needs_attention",
      "required_sections": [
        "findings",
        "evidence_or_assumptions",
        "uncertainties",
        "next_action"
      ]
    },
    {
      "id": "check",
      "kind": "audit",
      "workers": [
        "reviewer"
      ],
      "input_stages": [
        "review",
        "revision"
      ],
      "instruction": "Check the revision against the original brief and your objections. State unresolved issues.",
      "context": "continue",
      "release": "after_all_required",
      "failure_policy": "needs_attention",
      "required_sections": [
        "findings",
        "evidence_or_assumptions",
        "uncertainties",
        "next_action"
      ]
    },
    {
      "id": "delivery",
      "kind": "synthesize",
      "workers": [
        "author"
      ],
      "input_stages": [
        "revision",
        "check"
      ],
      "instruction": "Deliver the revised artifact and clearly disclose any material unresolved issue.",
      "context": "continue",
      "release": "after_all_required",
      "failure_policy": "needs_attention",
      "required_sections": [
        "findings",
        "evidence_or_assumptions",
        "uncertainties",
        "next_action"
      ]
    }
  ],
  "final_stage": "delivery"
}
