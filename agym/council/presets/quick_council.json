{
  "schema_version": 1,
  "draft": true,
  "inputs": [
    {
      "id": "brief",
      "description": "User-supplied goal, constraints and relevant evidence.",
      "required": true
    }
  ],
  "limits": {
    "global_concurrency": 4,
    "per_account_concurrency": 1,
    "max_model_calls": 24,
    "max_retries_per_task": 1,
    "max_wall_seconds": 7200,
    "automatic_account_switching": false
  },
  "execution_mode": "supplied_evidence",
  "name": "Quick council",
  "goal": "Compare approaches to the user's question and give a reasoned answer, preserving material disagreement.",
  "workers": [
    {
      "id": "coordinator",
      "name": "Coordinator",
      "account_ref": "profile-1",
      "model": "<choose-discovered-model>",
      "role": "synthesizer",
      "instructions": "Be concise, fair to competing explanations, and explicit about uncertainty.",
      "task": "Integrate the contributions without inventing consensus."
    },
    {
      "id": "analyst",
      "name": "Analyst",
      "account_ref": "profile-2",
      "model": "<choose-discovered-model>",
      "role": "analyst",
      "instructions": "Identify practical options and support claims with the supplied evidence.",
      "task": "Develop an independent answer."
    },
    {
      "id": "critic",
      "name": "Constructive critic",
      "account_ref": "profile-3",
      "model": "<choose-discovered-model>",
      "role": "reviewer",
      "instructions": "Challenge assumptions constructively; do not reject ideas merely to be adversarial.",
      "task": "Identify errors, missing evidence and tradeoffs."
    }
  ],
  "stages": [
    {
      "id": "independent",
      "kind": "independent",
      "workers": [
        "coordinator",
        "analyst",
        "critic"
      ],
      "input_stages": [],
      "instruction": "Independently answer the brief. Do not access peer drafts.",
      "context": "fresh",
      "release": "after_all_required",
      "failure_policy": "needs_attention",
      "required_sections": [
        "findings",
        "evidence_or_assumptions",
        "uncertainties",
        "next_action"
      ]
    },
    {
      "id": "critique",
      "kind": "critique",
      "workers": [
        "analyst",
        "critic"
      ],
      "input_stages": [
        "independent"
      ],
      "instruction": "Review the released answers. Distinguish factual objections from preferences.",
      "context": "continue",
      "release": "after_all_required",
      "failure_policy": "needs_attention",
      "required_sections": [
        "findings",
        "evidence_or_assumptions",
        "uncertainties",
        "next_action"
      ]
    },
    {
      "id": "answer",
      "kind": "synthesize",
      "workers": [
        "coordinator"
      ],
      "input_stages": [
        "independent",
        "critique"
      ],
      "instruction": "Produce the final answer with supporting reasons, limitations and unresolved disagreement.",
      "context": "continue",
      "release": "after_all_required",
      "failure_policy": "needs_attention",
      "required_sections": [
        "findings",
        "evidence_or_assumptions",
        "uncertainties",
        "next_action"
      ]
    }
  ],
  "final_stage": "answer"
}
